<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music App with Custom Theme</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Left Sidebar -->
    <%- include('./partials/slide_bar') %>
    
    <!-- Main Content -->
    <div class="main-content">
        <div class="greeting">Good evening</div>
        
        <div class="recently-played">
            <div class="section-title">Recently played</div>
            <div class="cards-container">
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Daily Mix 1</div>
                    <div class="card-desc">Made for you</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Discover Weekly</div>
                    <div class="card-desc">Your weekly mixtape</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Top Hits 2023</div>
                    <div class="card-desc">By Musicfy</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Chill Lofi</div>
                    <div class="card-desc">Relaxing beats</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Workout Energy</div>
                    <div class="card-desc">Pump up your workout</div>
                </div>
            </div>
        </div>
        
        <div class="made-for-you">
            <div class="section-title">Made for You</div>
            <div class="cards-container">
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Your Top Mix</div>
                    <div class="card-desc">Based on your listening</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">New Releases</div>
                    <div class="card-desc">Fresh tracks you'll love</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Throwback Hits</div>
                    <div class="card-desc">Relive the classics</div>
                </div>
                <div class="card">
                    <div class="card-img"></div>
                    <div class="play-icon"><i class="fas fa-play"></i></div>
                    <div class="card-title">Indie Discoveries</div>
                    <div class="card-desc">Hidden gems you'll love</div>
                </div>
            </div>
        </div>
    </div>

    <div id="resizer"></div>

    <!-- Right Sidebar -->
    <%- include('./partials/Right_side') %>
</body>
<script src="rezier.js"></script>
</html>