<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Verify OTP</title>
    <link rel="stylesheet" href="/auth.css">
</head>
<body>

    <div class="login-container">
        <h2>Verify OTP</h2>
        
        <form action="/Musicfy/verify-otp" method="POST">
            <div class="input-group">
                <label for="user_otp">Enter Your OTP</label>
                <input type="number" id="user_otp" name="user_otp" placeholder="Enter Your OTP" value="" required>
                <input type="hidden" id="our_otp" name="our_otp" placeholder="Enter Your OTP" value="<%= otp%>" required>
            </div>
                      
            <button type="submit">Verify OTP</button>            
         
 
        </form>
        
        <h4>OTP Send on ( <%=user_email%> )</h4>
    </div>


</body>
</html>
