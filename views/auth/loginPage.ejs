<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Login</title>
    <link rel="stylesheet" href="/auth.css">
</head>

<body>
    <div class="login-container">
        <h2>Musicfy Login </h2>
        <% if (error_msg) { %>
            <div class="alert alert-danger">
                <%= error_msg %>
            </div>
            
            <% } %>
                <form action="/Musicfy/login/post" method="POST">
                    <div class="input-group">
                        <label for="Registration_email">Enter Your E-mail</label>
                        <input type="text" id="Registration_email" name="Registration_email"
                            placeholder="Enter Your E-mail" required>
                    </div>

                    <div class="input-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>

                    <button type="submit">Log-in</button>
                    <div class="signup-link">
                        Don't have account? <a href="/Musicfy/sing-up">Sing Up</a>
                    </div>
                </form>
    </div>
</body>

</html>