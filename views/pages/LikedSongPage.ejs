<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music App with Custom Theme</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/singer.css">
   <link rel="icon" href="data:,">


</head>

<body>
    <!-- Left Sidebar -->
    <%- include('../partials/slide_bar', { page: 'likedSongs' }) %>

        <!-- Main Content -->
        <div class="main-content">
            <div class="header">
                <img src="/uploads/Profile/liked.png" alt=" Album Cover" class="album-cover">
                <div class="album-info">
                    <h1>
                     Liked Songs
                    </h1>
                    <p class="album-meta">
                        <strong>
                          
                        </strong>
                    </p>

                </div>
            </div>

            <hr class="divider">

            <h2 class="trackList">Track List</h2>
            <div class="track-list">
                <% likedSongs.forEach(function(songs, index) { %>




                    <div class="card Music" data-src="<%= songs.songSrc %>">
                        <img class="card-img" src="<%= songs.img %>" alt="Album Art">

                        <div class="card-title">
                            <%= songs.title %>
                        </div>

                        <div class="card-desc">
                            <%= songs.artist %>
                        </div>

                        <i class="fa fa-heart likepage like-btn " data-src="<%= songs.songSrc %>"
                           ></i>
                    </div>



                    <% }) %>
            </div>




            
        </div>



        </div>

        <div id="resizer"></div>

 
        <%- include('../partials/Right_side') %>
</body>
<script src="https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.2/color-thief.umd.js"></script>
<script src="/bagcolor.js"></script>
<script src="/app.js"></script>
<script src="/likedOneSong.js"></script>
</html>