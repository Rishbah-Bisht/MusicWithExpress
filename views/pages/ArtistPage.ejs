<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music App with Custom Theme</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/singer.css">
    <link rel="icon" href="data:,">


</head>

<body>
    <!-- Left Sidebar -->
    <%- include('../partials/slide_bar', { page: 'home' }) %>

        <!-- Main Content -->
        <div class="main-content">
            <div class="header">
                <img src="<%=user_info.img %>" alt=" Album Cover" class="album-cover">
                <div class="album-info">
                    <h1>
                        <%=user_info.userName %>
                    </h1>
                    <p class="album-meta">
                        <strong>
                            <%=user_info.profession %>
                        </strong>
                    </p>

                </div>

            </div>
            <div class="playing-btns">
                <button class="play-all-btn"><i class="fas fa-play"></i></button>
                <button class="shuffle-btn"><i class="fa-solid fa-shuffle"></i></button>
            </div>

            <hr class="divider">

            <h2 class="trackList">Track List</h2>
            <div class="track-list">
                 <% Songs.forEach(function(song) { const isLiked=likedSong.some(function(liked) { return
                        liked.title===song.title && liked.artist===song.artist; }); %>
                        <div class="card Music" data-src="/<%= song.audioFile %>">
                            <img class="card-img" src="/<%= song.coverImage %>" alt="">

                            <div class="card-title">
                                <%= song.title %>
                            </div>

                            <div class="card-desc">
                                <%= song.artist %>
                            </div>

                            <i class="fa fa-heart like-btn <%= isLiked ? 'liked' : '' %>"
                                data-src="/<%= song.audioFile %>"></i>
                        </div>
                        <% }) %>
            </div>

            <div class="made-for-you">
                <div class="section-title">Albums</div>
                <div class="cards-container">
                    <% if(albums){%>
                        <% albums.forEach(album=> { %>
                            <a href='/Musicfy/Album/<%=album.title %>' class="album-card">
                                <div class="album-cover">
                                    <img src="<%=album.coverImage %>" class="album-title"></img>
                                </div>
                                <div class="album-info">
                                    <div class="artists-title">
                                        <%=album.title %>
                                    </div>
                                    <div class="artists-list">
                                        <%=album.Artist %>
                                    </div>

                                </div>
                            </a>
                            <% }); %>
                                <% }%>
                </div>
            </div>


            <footer>
                <h1>Bio</h1>
                <h2>
                    <%=user_info.bio %>
                </h2>
            </footer>
        </div>



        </div>

        <div id="resizer"></div>

        <!-- Right Sidebar -->
        <%- include('../partials/Right_side') %>
</body>

<script src="https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.2/color-thief.umd.js"></script>
<script src="/bagcolor.js"></script>
<script src="/app.js"></script>
<script src="/likedOneSong.js"></script>

</html>