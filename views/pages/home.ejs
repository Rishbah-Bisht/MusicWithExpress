<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music App with Custom Theme</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <!-- Left Sidebar -->
    <%- include('../partials/slide_bar', { page: 'home' }) %>

        <!-- Main Content -->
        <div class="main-content">

            <div class="greeting">Good evening</div>

            <div class="recently-played">
                <div class="section-title">Recently played</div>
                <div class="cards-container">


                </div>
            </div>

            <div class="made-for-you">
                <div class="section-title">Made for You</div>
                <div class="cards-container2">

                </div>
            </div>

            <div class="made-for-you">
                <div class="section-title">Made for You</div>
                <div class="cards-container">
                    <% if(albums){%>
                        <% albums.forEach(album=> { %>
                            <a href='/Musicfy/Album/<%=album.title %>' class="album-card">
                                <div class="album-cover">
                                    <img src="<%=album.coverImage %>" class="album-title"></img>
                                </div>
                                <div class="album-info">
                                    <div class="artists-title"><%=album.title %></div>
                                    <div class="artists-list"><%=album.Artist %></div>
                                    
                                </div>
                            </a>
                            <% }); %>
                                <% }%>
                </div>
            </div>
        </div>

        <div id="resizer"></div>

        <!-- Right Sidebar -->
        <%- include('../partials/Right_side') %>
</body>
<script src="rezier.js"></script>
<script src="app.js"></script>

</html>