<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Album Upload Portal</title>
    <link rel="stylesheet" href="/uploads.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
  <%- include('../partials/slide_bar', { page: 'create' }) %>


 <div class="main-content">
  
<form action="/upload-song" method="POST" enctype="multipart/form-data">
  <h1>Upload Song</h1>

  <div>
    <label>Song Title:</label>
    <input type="text" name="title" required>
  </div>

  <div>
    <label>Artist:</label>
    <input type="text" name="artist"  required >
  </div>

  <div>
    <label>Main Artist:</label>
    <input type="text" name="mainArtist" value= '<%=user_name%>' required >
  </div>

  <div>
    <label>Cover Image:</label>
    <input type="file" name="coverImage" accept="image/*" required>
  </div>

  <div>
    <label>Audio File:</label>
    <input type="file" name="audioFile" accept="audio/*" required>
  </div>

  <br><br>
  <button type="submit">Upload Song</button>
</form>

</div>
<script>

  </script>

  
</body>
</html>