<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music App with Custom Theme</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/profile.css">
</head>

<body>
    <!-- Left Sidebar -->
    <%- include('../partials/slide_bar') %>

        <div class="profile-main-content">
            <form method="POST" action="/Update-user-info" enctype="multipart/form-data">
                <div class="container">

                    <div class="header">

                        <img id="profile-picture" src="<%=user_info.img %>" alt="Profile Picture"
                            class="profile-picture">


                        <div class="info">
                            <h2></h2>
                        </div>

                        <input type="file" id="file-input" name="p_img" accept="image/*" value="">
                        <label for="file-input" class="upload-label">Upload</label>
                    </div>

                    <div class="form-group">
                        <label for="id">Musicfy ID</label>
                        <input id="id" placeholder="id" name="id" type="text" autocomplete="off" readonly
                            value="<%= user_info._id%>" />

                        <label for="username">User Name</label>
                        <input id="username"  name="username" type="username" autocomplete="off"
                            value="<%= user_info.userName%>" readonly />

                        <label for="nickname">Nick Name (Edit)</label>
                        <input id="nickname"  name="nickname" type="text" autocomplete="off"
                            value="<%= user_info.name%>" />

                        <label for="email">Email</label>
                        <input id="email" placeholder="email" name="email" type="text" autocomplete="off"
                            value="<%= user_info.email%>" readonly/>

                        <label for="Profession">Profession</label>
                        <input id="Profession" placeholder="Profession" name="Profession" type="text" autocomplete="off"
                            value="<%= user_info.profession%>"readonly />

                    </div>

                    <div class="form-group">
                        <label for="bio">Bio</label>
                        <textarea id="bio" name="bio" placeholder="Bio"
                            autocomplete="off"><%= user_info.bio%></textarea>
                        <p class="note">0 / 150</p>
                    </div>

                    <button class="submit-btn">
                        Submit
                    </button>

                </div>
            </form>
        </div>



</body>
<script>
    // Upload picture functionality
function setProfilePicture(event) {
  const file = event.target.files[0];
  if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
          const profilePicture = document.getElementById('profile-picture');
          profilePicture.src = e.target.result;
          
          // Trigger form validation after image is loaded
          checkForm();
      };
      reader.readAsDataURL(file);
  }
}
document.getElementById('file-input').addEventListener('change', setProfilePicture);


</script>
</html>