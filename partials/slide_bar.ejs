<div class="left-sidebar">
    <div class="logo">Musicfy</div>

    <div class="search-bar">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search...">
    </div>

    <div class="nav-menu">
        <a href="/Musicfy/home" class="nav-item <%= page === 'home' ? 'nav-item active' : '' %>">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <a href="/Musicfy/browse" class="nav-item <%= page === 'browse' ? 'nav-item active' : '' %>">
            <i class="fas fa-search"></i>
            <span>Browse</span>
        </a>
        <a href="/Musicfy/library" class="nav-item <%= page === 'library' ? 'nav-item active' : '' %>">
            <i class="fas fa-book"></i>
            <span>Library</span>
        </a>
        <a href="/Musicfy/create-playlist" class="nav-item <%= page === 'create' ? 'nav-item active' : '' %>" style="margin-top: 30px;">
            <i class="fas fa-plus-square"></i>
            <span>Create Playlist</span>
        </a>
        <a href="/Musicfy/liked-songs" class="nav-item <%= page === 'liked' ? 'nav-item active' : '' %>">
            <i class="fas fa-heart"></i>
